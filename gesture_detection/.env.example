# このファイルを .env へコピーします。既存の環境変数を優先します。
# 相対パスはプロジェクトルート基準で解決します。絶対パスも使用できます。

CAMERA_INDEX=0
# OpenCVバックエンドID: 0 = 自動（CAP_ANY）、200 = Linux V4L2（CAP_V4L2）。
CAMERA_BACKEND=0
CAMERA_FOURCC=MJPG

# 空欄ならカメラ入力。例: VIDEO_SOURCE="sample_movies/sample.mp4"
VIDEO_SOURCE=
OUTPUT_DIR=output
# 空欄なら <OUTPUT_DIR>/<入力ファイル名><実行時刻>.output.mp4
VIDEO_OUTPUT_PATH=

# IMAGE = 各画像を独立処理、VIDEO = 同期的な時間追跡。
POSE_RUNNING_MODE=VIDEO
POSE_MODEL_PATH=pose_landmarker_lite.task
# trueならMediaPipe/Abseilの通常は不要なネイティブ起動ログを隠します。
# モデルや描画の初期化を調査するときはfalseにします。
SUPPRESS_MEDIAPIPE_STARTUP_LOGS=true
YOLO_MODEL_PATH=yolov8n.pt

# 正の整数。FPSはジェスチャー処理窓の標本数にも使用します。
FPS=30
VIDEO_OUTPUT_BUFFER_FRAMES=8

# Unity通知。動画入力ではtrueでも送信しません。
GESTURE_DELIVERY_ENABLED=false
# 127.0.0.1固定。unity_bridgeのWebSocket(5000)とは別ポート。
GESTURE_DELIVERY_PORT=5001
GESTURE_STATE_INTERVAL=0.1
GESTURE_STALE_TIMEOUT=0.5
GESTURE_EVENT_TTL=1.0
GESTURE_RETRY_INTERVAL=0.1
GESTURE_MAX_PENDING=64

# VIDEOモードの骨格表示だけを平滑化（所作判定は元座標）。falseで無効化。
POSE_DISPLAY_SMOOTHING=true

# VIDEOモード: 取得時だけ背景を隠し、取得後は全画面で実演者を追跡。
POSE_SELECT_SUBJECT=true
# 胴体中心が入る範囲（左,上,右,下）。画面の左上=0,0、右下=1,1。
SUBJECT_AREA=0.35,0.15,0.75,0.90
# 奥の小さい人物を除く。画面の高さ/幅に対する比率。
SUBJECT_MIN_TORSO_HEIGHT=0.18
SUBJECT_MIN_SHOULDER_WIDTH=0.10
