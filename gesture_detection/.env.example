# Copy to .env. Existing environment variables take precedence.
# Relative paths are resolved from the project root. Absolute paths are supported.

CAMERA_INDEX=0
# OpenCV backend ID: 0 = automatic (CAP_ANY), 200 = Linux V4L2 (CAP_V4L2).
CAMERA_BACKEND=0
CAMERA_FOURCC=MJPG

# Empty = camera input. Example: VIDEO_SOURCE="sample_movies/sample.mp4"
VIDEO_SOURCE=
OUTPUT_DIR=output
# Empty = <OUTPUT_DIR>/<source filename><YYYY-MM-DD>.output.mp4
VIDEO_OUTPUT_PATH=

POSE_MODEL_PATH=pose_landmarker_lite.task
YOLO_MODEL_PATH=yolov8n.pt

# Positive integers. FPS also controls the gesture processing window size.
FPS=30
VIDEO_OUTPUT_BUFFER_FRAMES=8
