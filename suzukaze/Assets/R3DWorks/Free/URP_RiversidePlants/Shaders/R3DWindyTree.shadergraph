{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "fb44046f3b94498b928fa53650de476a",
    "m_Title": "R3DWorks Windy Shader for Custom Tree Assets",
    "m_Content": "Features:\n\t3 levels of wind offset vectors\n\tLOD Crossfade\n\tHigh Performance\n\n\tVertex data needed:\n\t\tRed: gradient along the trunk of the tree 0.0 at bottom and 1.0 at top\n\t\tGreen: gradient along big branches off the trunk\n\t\tBlue: gradient along leaf plane meshes\n\n \n\tThese gradients are used to apply different wind noise vectors to achieve\n\toverall natural looking wind motion for a tree mesh",
    "m_TextSize": 3,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2378.0,
        "y": -857.0,
        "width": 2619.0,
        "height": 1436.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

