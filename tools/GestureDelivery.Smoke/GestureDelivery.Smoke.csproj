<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Test the shipped netstandard2.0 DLL, not NuGet's different net5 build. -->
    <Reference Include="Google.Protobuf">
      <HintPath>../../suzukaze/Assets/GestureDelivery/Plugins/Google.Protobuf.dll</HintPath>
    </Reference>
    <Compile Include="../../suzukaze/Assets/GestureDelivery/Core/*.cs" />
    <Compile Include="../../suzukaze/Assets/GestureDelivery/Generated/Gesture.cs" />
    <Compile Include="../../suzukaze/Assets/GestureDelivery/Tests/EditMode/*.cs" />
    <Compile Include="GoldenInteropTests.cs" />
    <Compile Include="SocketLoopTests.cs" />
    <None Include="../../gesture_protocol/tests/fixtures/messages.json" Link="messages.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
